# ==========================================
# Vyoma (DevAssembly) Environment Configuration
# ==========================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development

# Allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT Secret (Used for session token generation)
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev_jwt_secret_key_vyoma_2026

# --- Database Configuration (Optional) ---
# If PostgreSQL is not provided, backend automatically uses local db.json storage.
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vyoma
PGPORT=5432

# --- Frontend Configuration ---
# API URL for frontend to connect to the backend
VITE_API_URL=http://localhost:5000

# --- Email Notifications (Optional - Resend SMTP) ---
RESEND_SMTP_USER=resend
RESEND_SMTP_PASS=your_resend_api_key_placeholder
EMAIL_FROM=noreply@vyoma.dev

# --- Legacy OAuth (Optional / Testing) ---
# Note: Platform is now open by default with automatic profile loading.
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder
OAUTH_REDIRECT_BASE_URL=http://localhost:5000

# ==========================================
# Vyoma Environment Configuration
# ==========================================

# --- Backend Configuration ---
# The port the Express server will run on
PORT=5000

# REQUIRED: Security secret for JWT (JSON Web Tokens)
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL Database Configuration (Optional)
# If not provided, the backend falls back to local in-memory db.json storage.
PGUSER=postgres
PGHOST=localhost
PGDATABASE=vyoma
PGPASSWORD=postgres
PGPORT=5432

# --- Frontend Configuration ---
# API URL for the frontend to connect to the backend.
# In production, change this to your deployed backend URL.
VITE_API_URL=http://localhost:5000

# --- OAuth Configuration (Required for Google/GitHub Login) ---
# Obtain these by creating an OAuth App on Google Cloud Console
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtain these by creating an OAuth App in your GitHub Developer Settings
VITE_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
